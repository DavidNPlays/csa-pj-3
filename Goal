public Class Goal(){
    public String name;
    public String type;
    public double target;
    public String deadline;

    public Goal(String name, String type, double target, String deadline){
        this.name=name;
        this.type=type;
        this.target=target;
        this.deadline=deadline;
    }

    public String toString(){
        return name + " has a goal for " + type + " of " + target + " by " + deadline;
    }
}